# CHIEF Mobile - Environment Configuration Example
# Copy to .env.local for local overrides.
#
# CRITICAL SECURITY RULE:
# VITE_CHIEF_DEV_MODE controls build-time development simulation.
# - Production deployments MUST leave this set to 'false' or omit it entirely.
# - DEV mode is build-time only and must NEVER be browser-enableable at runtime.
# - When false, all simulation personas, mock endpoints, and test fixtures are disabled.
VITE_CHIEF_DEV_MODE=false

# Chief API Base URL
# - In production, Chief Mobile proxies API requests through '/api/v1'.
# - For local development against a standalone Chief backend server, configure the URL below.
VITE_CHIEF_API_BASE_URL=/api/v1
